# Dockerfile for the FastAPI replacement dashboard ("dashboard-next").
#
# Temporary scaffolding for the tab-by-tab migration off Streamlit -- see
# docs/adr/0003-dashboard-rewrite-fastapi-htmx.md and
# docs/adr/0004-dashboard-migration-parallel-service-cutover.md. Deleted at cutover,
# once every tab has been ported and this code moves into Dockerfile.dashboard's place.
FROM python:3.11-slim

WORKDIR /app

# Install requirements from the full project requirements.txt (shared with the other
# services); dashboard_next only imports a subset of it so far.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ /app/scripts/
COPY observability/ /app/observability/

RUN mkdir -p /app/output /app/slskd_docker_data

EXPOSE 8502

ENV PYTHONPATH="/app"

CMD ["uvicorn", "observability.dashboard_next.app:app", "--host", "0.0.0.0", "--port", "8502"]
