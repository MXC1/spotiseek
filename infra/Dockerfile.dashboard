# Dockerfile for the Spotiseek dashboard (FastAPI + HTMX) -- see
# docs/adr/0003-dashboard-rewrite-fastapi-htmx.md.
FROM python:3.11-slim

WORKDIR /app

# ffmpeg: needed by scripts/audio_validation.py's decode check (Manual/Auto Import).
# docker-cli: gives us the `docker` client so the Execution Inspection tab can stream
# live container logs (via the mounted socket -- see docker-compose.yml) with
# scripts/docker_control.py, the same way the `backup` service already does.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg docker-cli \
    && rm -rf /var/lib/apt/lists/*

# Install requirements from the full project requirements.txt (shared with the other
# services); the dashboard only imports a subset of it so far.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ /app/scripts/
COPY observability/ /app/observability/

RUN mkdir -p /app/output /app/slskd_docker_data

EXPOSE 8501

ENV PYTHONPATH="/app"

CMD ["uvicorn", "observability.dashboard.app:app", "--host", "0.0.0.0", "--port", "8501"]
