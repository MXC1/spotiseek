SLSKD_USERNAME=<YOUR_SOULSEEK_USERNAME>
SLSKD_PASSWORD=<YOUR_SOULSEEK_PASSWORD>
TOKEN=<A_RANDOM_API_KEY>
SPOTIFY_CLIENT_ID=<YOUR_SPOTIFY_CLIENT_ID>
SPOTIFY_CLIENT_SECRET=<YOUR_SPOTIFY_CLIENT_SECRET>
APP_ENV=prod
HOST_BASE_PATH=<PATH_TO_THIS_DIRECTORY>

# Deployment Configuration
# The one environment whose workflow/dashboard/backup code only changes via `invoke deploy`,
# never just by being the hot environment. See docs/adr/0002-gated-environment-deploys-via-git-archive.md.
DEPLOY_GATED_ENV=all_playlists
# Managed automatically by `invoke up`/`build`/`setenv` -- do not edit by hand.
CODE_ROOT=.

# Remuxing Configuration
# Set to true to prefer MP3 320kbps for all downloads (and remux non-MP3 to MP3)
# Set to false to prefer lossless formats (remux to WAV) and lossy to MP3 320kbps (default)
PREFER_MP3=true

# Logging Configuration
# Set LOG_LEVEL to control verbosity: DEBUG, INFO, WARNING, or ERROR (default: INFO)
# File logging: Always writes WARNING/ERROR and dashboard-critical events
# Console logging: Only shows this level and above
LOG_LEVEL=INFO

# Task Scheduler Intervals (in minutes)
# Each task runs on its own schedule. Set to 0 to disable a task.
TASK_SCRAPE_PLAYLISTS_INTERVAL=1440       # Scrape Spotify playlists (default: once per day)
TASK_INITIATE_SEARCHES_INTERVAL=60        # Initiate Soulseek searches (default: every hour)
TASK_POLL_SEARCH_RESULTS_INTERVAL=15      # Poll for search results (default: every 15 minutes)
TASK_SYNC_DOWNLOAD_STATUS_INTERVAL=5      # Sync download status from slskd (default: every 5 minutes)
TASK_MARK_QUALITY_UPGRADES_INTERVAL=1440  # Check for quality upgrades (default: once per day)
TASK_PROCESS_UPGRADES_INTERVAL=60         # Process upgrade queue (default: every hour)
TASK_EXPORT_LIBRARY_INTERVAL=1440         # Export iTunes library (default: once per day)
TASK_REMUX_EXISTING_FILES_INTERVAL=360    # Remux existing files to match preferences (default: every 6 hours)

# Backup Configuration
# BACKUP_DEST is a host path (used only in docker-compose.yml's volume mount);
# default keeps backups inside the repo, gitignored.
BACKUP_DEST=./backups
# Password protecting the restic repositories. Required for `invoke backup`/`invoke restore`.
BACKUP_RESTIC_PASSWORD=<A_RANDOM_PASSWORD>
# Comma-separated environments to back up automatically (empty = none; on-demand `invoke backup` always works)
BACKUP_SCHEDULE_ENVS=
# Local hour (0-23, in BACKUP_SCHEDULE_TIMEZONE) each scheduled environment is backed up, once per day
BACKUP_SCHEDULE_HOUR=4
# A scheduled backup for the hot environment is deferred (retried later, same day) unless
# at least this many minutes have passed since the last `invoke up`/`invoke deploy`
BACKUP_QUIET_MINUTES=60
# IANA timezone BACKUP_SCHEDULE_HOUR is interpreted in
BACKUP_SCHEDULE_TIMEZONE=Europe/London
# Retention policy applied after every backup (restic `forget --keep-*`)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6